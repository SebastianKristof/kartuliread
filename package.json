{
  "name": "kartuliread---georgian-reading-practice",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check:data": "node scripts/checkExercisesData.mjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "cap:sync": "npm run build && cap sync android",
    "android:open": "npm run cap:sync && cap open android",
    "android:debug": "npm run cap:sync && cd android && ./gradlew assembleDebug",
    "check:offline": "node scripts/checkOfflineBuild.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/preferences": "^8.0.1",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/noto-sans-georgian": "^5.3.0",
    "@fortawesome/fontawesome-free": "^6.7.2",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.7.0",
    "postcss": "^8.5.33",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  },
  "engines": {
    "node": ">=22"
  }
}
